# CALYX — environment placeholders (no real secrets)
# Copy to .env.local and fill when integrating payments.
# Do NOT commit real keys. Live checkout is NOT enabled until wired.

# Public site URL (used for payment return / success redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which provider the UI should advertise as primary: yookassa | stripe
# RU default: yookassa
NEXT_PUBLIC_PAYMENT_PROVIDER=yookassa

# --- ЮKassa (YooKassa) — primary for RU ---
# TODO(payments): Obtain from https://yookassa.ru/ and enable only in production.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional webhook secret for payment notifications
YOOKASSA_WEBHOOK_SECRET=

# --- Stripe — optional intl / fallback ---
# TODO(payments): Obtain from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
